{
    "name": "uri-interop/impl",
    "type": "library",
    "description": "Reference implementations of Uri-Interop.",
    "keywords": ["uri", "rfc 3986", "rfc3986"],
    "license": "MIT",
    "homepage": "https://github.com/uri-interop/impl",
    "authors": [
        {
            "name": "Uri-Interop Impl Contributors",
            "homepage": "https://github.com/uri-interop/impl/contributors"
        }
    ],
    "require": {
        "php": ">=8.4",
        "uri-interop/interface": "^1.0"
    },
    "autoload": {
        "psr-4" : {
            "UriInterop\\Impl\\": "src/"
        }
    },
    "require-dev": {
        "pds/composer-script-names": "^1.0",
        "pds/skeleton": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "pmjones/php-styler": "0.x@dev"
    },
    "autoload-dev": {
        "psr-4" : {
            "UriInterop\\Impl\\": "tests/"
        }
    },
    "scripts": {
        "analyze": "./vendor/bin/phpstan",
        "check": "composer test && composer analyze && composer cs-clear && composer cs-check",
        "cs-check": "./vendor/bin/php-styler check",
        "cs-clear": "./vendor/bin/php-styler clear-cache",
        "cs-fix": "./vendor/bin/php-styler apply",
        "test": "./vendor/bin/phpunit",
        "test-coverage": "./vendor/bin/phpunit --coverage-html=./tmp/coverage"
    }
}
